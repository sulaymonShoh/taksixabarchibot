# Controller Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# Administrator User ID (authorized Telegram ID)
ADMIN_ID=123456789

# Client API ID and API Hash (from my.telegram.org)
API_ID=1234567
API_HASH=abcdef1234567890abcdef1234567890

# Client Session Name (string identifying the local .session file)
SESSION_NAME=worker_account

# Path to the SQLite database file
DB_PATH=data/broadcast.db
